// Prisma Schema for BalanceVault – Financial Account Management System
// Target Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  COMPLIANCE_OFFICER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  BUSINESS
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
  FEE
  INTEREST
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
  FLAGGED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum KycTier {
  TIER_1_BASIC      // Daily limit: $5,000
  TIER_2_VERIFIED   // Daily limit: $25,000
  TIER_3_INSTITUTIONAL // Daily limit: $250,000
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  firstName             String
  lastName              String
  phone                 String?
  avatarUrl             String?
  role                  Role                   @default(USER)
  status                UserStatus             @default(PENDING_VERIFICATION)
  kycTier               KycTier                @default(TIER_1_BASIC)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  accounts              Account[]
  applications          OnboardingApplication[]
  auditLogsTriggered    AuditLog[]             @relation("ActorAuditLogs")

  @@index([email])
  @@index([role])
}

model Account {
  id            String        @id @default(uuid())
  accountNumber String        @unique
  routingNumber String        @default("021000021")
  name          String
  type          AccountType   @default(CHECKING)
  currency      String        @default("USD")
  balance       Decimal       @default(0.00) @db.Decimal(14, 2)
  available     Decimal       @default(0.00) @db.Decimal(14, 2)
  status        AccountStatus @default(ACTIVE)
  interestRate  Decimal       @default(0.00) @db.Decimal(5, 4) // e.g. 0.0480 for 4.8%
  dailyLimit    Decimal       @default(5000.00) @db.Decimal(10, 2)
  isCardFrozen  Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions  Transaction[]

  @@index([userId])
  @@index([accountNumber])
}

model Transaction {
  id            String            @id @default(uuid())
  referenceId   String            @unique
  amount        Decimal           @db.Decimal(14, 2)
  currency      String            @default("USD")
  type          TransactionType
  status        TransactionStatus @default(COMPLETED)
  description   String
  counterparty  String?
  category      String?
  metadata      Json?
  fee           Decimal           @default(0.00) @db.Decimal(8, 2)
  createdAt     DateTime          @default(now())

  accountId     String
  account       Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdAt])
  @@index([referenceId])
}

model OnboardingApplication {
  id               String            @id @default(uuid())
  applicationNumber String           @unique
  status           ApplicationStatus @default(SUBMITTED)
  requestedTier    KycTier           @default(TIER_2_VERIFIED)
  legalName        String
  dateOfBirth      String
  taxId            String            // Synthetic encrypted / masked
  addressStreet    String
  addressCity      String
  addressState     String
  addressZip       String
  country          String            @default("United States")
  employmentStatus String
  annualIncome     Decimal           @db.Decimal(12, 2)
  sourceOfWealth   String
  documentType     String            // Passport, Driver's License, National ID
  documentRef      String
  riskScore        Int               @default(15) // 0-100 score, lower is safer
  adminNotes       String?
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String   // AUTH_LOGIN, TRANSFER_INITIATED, KYC_APPROVED, etc.
  entity      String   // User, Account, Transaction, Application
  entityId    String?
  details     String
  severity    String   @default("INFO") // INFO, WARN, SECURITY_ALERT, CRITICAL
  ipAddress   String   @default("127.0.0.1")
  userAgent   String?
  createdAt   DateTime @default(now())

  actorId     String?
  actorEmail  String?
  actorRole   Role?
  actor       User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([actorId])
}
